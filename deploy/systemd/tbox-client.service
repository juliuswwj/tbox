[Unit]
Description=tbox client (local SOCKS5H + service publishing tunnel)
Documentation=https://github.com/juliuswwj/tbox
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tbox client -c /etc/tbox/client.yaml
Restart=always
RestartSec=3s

# client.yaml plus the published TLS cert/keys it uploads live under /etc/tbox;
# keep them root:tbox 0640 (see deploy/README).
User=tbox
Group=tbox

# The client only opens local (SOCKS/admin) and outbound connections — no
# privileged ports.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Hardening.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# AF_NETLINK is required: sing-box opens a netlink socket at startup for its
# network/interface monitor (omitting it fails with EAFNOSUPPORT).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallArchitectures=native
ReadOnlyPaths=/etc/tbox

LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
